{
  "name": "@isdk/match-ex-template",
  "version": "0.1.1",
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "description": "Template interpolation plugin for @isdk/match-ex, backed by @isdk/template-engines. Importing it registers StringTemplate into the engine, so {{placeholder}} expectations interpolate out of the box.",
  "keywords": [
    "match-ex",
    "template",
    "interpolation",
    "plugin",
    "isdk"
  ],
  "homepage": "https://github.com/isdk/match-ex-template.js",
  "repository": "https://github.com/isdk/match-ex-template.js",
  "bugs": "https://github.com/isdk/match-ex-template.js/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build-fast": "tsup",
    "build": "pnpm run build-fast --dts-resolve --dts",
    "clean": "rm -fr dist",
    "format": "pnpm run format:base -c",
    "format:base": "prettier \"src/**/*.{ts,tsx,js,jsx,md}\"",
    "format:fix": "pnpm run format:base --write",
    "lint": "eslint .",
    "style": "pnpm run format:base -c && pnpm run lint",
    "style:fix": "pnpm run format:fix && npm run lint --fix",
    "test": "vitest run",
    "release": "pnpm run clean && pnpm run build && npx commit-and-tag-version -s",
    "release.alpha": "pnpm run release -- --prerelease alpha"
  },
  "dependencies": {
    "@isdk/match-ex": "workspace:^",
    "@isdk/template-engines": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "prettier": "^3.9.7",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.7.3",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  }
}
